*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Arial,Helvetica,sans-serif;color:#17231a;background:#f4f6f3}body{min-height:100vh}button,input{font:inherit}
.top{height:68px;background:#fff;border-bottom:1px solid #dfe4df;display:flex;align-items:center;justify-content:space-between;padding:0 32px}.logo{font-size:24px;font-weight:700;display:flex;align-items:baseline;gap:8px}.by{font-size:11px;font-weight:400;color:#69736c;letter-spacing:.02em}.plant{font-size:16px}.logo i{font-style:normal;color:#238447}.top-right{font-size:12px;color:#68736b}
.wrap{width:min(920px,calc(100% - 32px));margin:46px auto 60px}.intro{margin-bottom:25px}.intro h1{font-size:40px;line-height:1.05;line-height:1.05;letter-spacing:-1.2px;margin:0 0 10px}.intro p{margin:0;color:#68736b;font-size:16px;line-height:1.5;max-width:670px}
.card{background:#fff;border:1px solid #d9dfda;padding:22px}.drop{min-height:255px;border:1px dashed #78917e;background:#fafbf9;display:flex;align-items:center;justify-content:center;text-align:center;cursor:pointer;transition:.12s}.drop:hover,.drop.over{background:#f1f6f2;border-color:#238447}.drop-inner{max-width:450px;padding:20px}.camera{width:46px;height:34px;border:2px solid #51735a;margin:0 auto 16px;position:relative}.camera:before{content:"";position:absolute;width:15px;height:7px;border:2px solid #51735a;border-bottom:0;left:13px;top:-9px}.camera:after{content:"";position:absolute;width:11px;height:11px;border:2px solid #51735a;border-radius:50%;left:15px;top:9px}.drop strong{display:block;font-size:18px;margin-bottom:8px}.drop p{margin:0 0 17px;color:#68736b;font-size:14px}.choose{display:inline-block;background:#238f49;color:#fff;border:1px solid #238f49;padding:11px 20px;font-weight:700}
.preview{display:none;margin-top:16px;border:1px solid #d9dfda;background:#f7f8f6;padding:10px}.preview img{display:block;width:auto;max-width:100%;height:auto;max-height:390px;margin:auto}.actions{display:none;gap:10px;margin-top:14px}.btn{border:1px solid #238f49;background:#238f49;color:#fff;padding:11px 18px;font-weight:700;cursor:pointer}.btn.alt{background:#fff;color:#238447}.btn:disabled{opacity:.55;cursor:default}.message{min-height:18px;margin-top:12px;color:#68736b;font-size:13px}
.result{display:none;margin-top:23px;border-top:1px solid #d9dfda;padding-top:22px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.box{border:1px solid #d9dfda;padding:19px}.label{font-size:11px;font-weight:700;letter-spacing:.08em;color:#68736b}.big{font-size:27px;font-weight:700;margin-top:8px}.sub{font-size:13px;color:#68736b;margin-top:7px}.use{color:#22783e}.wait{color:#966616}.discard{color:#a63d3d}.bar{height:7px;background:#e2e6e2;margin-top:12px;overflow:hidden}.bar span{display:block;height:100%;width:0;background:#2b9250;transition:width .55s}.details{margin-top:15px;border-left:3px solid #9db4a2;background:#f5f7f4;padding:13px 14px;color:#4d594f;font-size:14px;line-height:1.5}.warning{margin:17px 0 0;color:#727b75;font-size:12px;line-height:1.5}
footer{text-align:center;color:#7a837d;font-size:12px;margin-top:25px}
