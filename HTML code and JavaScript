</head>
<body>
<header class="top"><div class="logo"><span class="brand-dark">Fresh</span><span class="brand-green">Check</span><span class="plant" aria-label="fresh plant">🌱</span><span class="by">By Quantum Nexus</span></div><div class="top-right">FOOD WASTE HELPER</div></header>
<main class="wrap">
<section class="intro"><h1>Is it still fresh?</h1><p>Photograph a fruit or vegetable and get a simple visual estimate with a clear next step.</p></section>
<section class="card">
<label class="drop" id="drop" for="file"><div class="drop-inner"><div class="camera-emoji" aria-hidden="true">📷</div><strong>Take or choose a photo</strong><p>One piece of produce, with good lighting, works best.</p><span class="choose">Choose photo</span></div><input id="file" type="file" accept="image/*" capture="environment"></label>
<div class="preview" id="preview"><img id="photo" alt="Selected produce"></div>
<div class="actions" id="actions"><button class="btn" id="check" type="button">Check freshness</button><button class="btn alt" id="again" type="button">Choose another</button></div>
<div class="message" id="message">Ready.</div>
<section class="result" id="result"><div class="grid"><div class="box"><div class="label">VISUAL ESTIMATE</div><div class="big" id="state">—</div><div class="bar"><span id="bar"></span></div><div class="sub" id="confidence">—</div></div><div class="box"><div class="label">RECOMMENDATION</div><div class="big" id="rec">—</div><div class="sub" id="produce">Photo analysis</div></div></div><div class="details" id="details">—</div><p class="warning">A photo cannot detect every form of spoilage. This tool is a visual estimate, not a food-safety test. If you see mold, leaking liquid, or other obvious spoilage, do not eat the produce.</p></section>
</section>
<section class="support">
  <div class="support-head"><strong>Supported produce</strong><span>Only these three fruits are supported.</span></div>
  <div class="fruit-row"><div class="fruit"><span>🍎</span><b>Apple</b></div><div class="fruit"><span>🍌</span><b>Banana</b></div><div class="fruit"><span>🍊</span><b>Orange</b></div></div>
</section>
<section class="how">
  <div><span class="step">01</span><div><b>Choose one fruit</b><p>Use a clear photo of a single apple, banana, or orange.</p></div></div>
  <div><span class="step">02</span><div><b>Get the scan</b><p>Use good lighting and keep the fruit mostly visible.</p></div></div>
  <div><span class="step">03</span><div><b>Follow the recommendation</b><p>Use now, wait, or discard — always check the fruit yourself too.</p></div></div>
</section>
<footer>FreshCheck • a practical way to help reduce avoidable food waste</footer>








</main>
<script>
'use strict';

// ==========================================
// FRESHCHECK AI
// ==========================================

var file = document.getElementById('file');
var drop = document.getElementById('drop');
var preview = document.getElementById('preview');
var photo = document.getElementById('photo');
var actions = document.getElementById('actions');
var check = document.getElementById('check');
var again = document.getElementById('again');
var message = document.getElementById('message');
var result = document.getElementById('result');
var state = document.getElementById('state');
var bar = document.getElementById('bar');
var confidence = document.getElementById('confidence');
var rec = document.getElementById('rec');
var produce = document.getElementById('produce');
var details = document.getElementById('details');


// ==========================================
// MODEL SETTINGS
// ==========================================

var aiModel = null;

var CLASS_NAMES = [
    "freshapples",
    "freshbanana",
    "freshoranges",
    "rottenapples",
    "rottenbanana",
    "rottenoranges"
];


// ==========================================
// LOAD TRAINED MODEL
// ==========================================

async function loadAIModel() {

    try {

        console.log("Loading FreshCheck AI model...");

        message.textContent =
            "Loading FreshCheck AI model...";

        aiModel = await tflite.loadTFLiteModel(
            "./freshcheck.tflite"
        );

        console.log(
            "FreshCheck AI model loaded successfully."
        );

        message.textContent = "AI ready.";

    } catch (error) {

        console.error(
            "FreshCheck AI model failed to load:",
            error
        );

        message.textContent =
            "AI model could not be loaded.";

    }
}


// ==========================================
// PREPROCESS IMAGE
// ==========================================

function preprocessImage(img) {

    return tf.tidy(function () {

        var tensor =
            tf.browser.fromPixels(img);

        tensor =
            tf.image.resizeBilinear(
                tensor,
                [160, 160]
            );

        tensor =
            tensor.toFloat();

        tensor =
            tensor.div(127.5);

        tensor =
            tensor.sub(1);

        tensor =
            tensor.expandDims(0);

        return tensor;
    });
}


// ==========================================
// RUN AI MODEL
// ==========================================

async function analyzeImage(img) {

    if (!aiModel) {

        throw new Error(
            "AI model has not loaded yet."
        );
    }

    var inputTensor =
        preprocessImage(img);

    var prediction = null;

    try {

        prediction =
            aiModel.predict(inputTensor);

        var probabilities =
            await prediction.data();

        var highestIndex = 0;

        for (
            var i = 1;
            i < probabilities.length;
            i++
        ) {

            if (
                probabilities[i] >
                probabilities[highestIndex]
            ) {

                highestIndex = i;
            }
        }

        var className =
            CLASS_NAMES[highestIndex];

        var confidenceValue =
            probabilities[highestIndex];

        console.log(
            "AI class:",
            className
        );

        console.log(
            "AI confidence:",
            confidenceValue
        );

        console.log(
            "All model outputs:",
            Array.from(probabilities)
        );

        return {

            className: className,

            confidence:
                confidenceValue
        };

    } finally {

        inputTensor.dispose();

        if (
            prediction &&
            typeof prediction.dispose === "function"
        ) {

            prediction.dispose();
        }
    }
}


// ==========================================
// PHOTO SELECTION
// ==========================================

function choose(f) {

    if (
        !f ||
        !f.type ||
        f.type.indexOf('image/') !== 0
    ) {

        message.textContent =
            'Please choose a JPG, JPEG, PNG, or WebP image.';

        return;
    }

    check.disabled = true;

    message.textContent =
        'Loading photo…';

    var reader =
        new FileReader();

    reader.onload =
        function(e) {

            photo.onload =
                function() {

                    preview.style.display =
                        'block';

                    actions.style.display =
                        'flex';

                    result.style.display =
                        'none';

                    check.disabled =
                        false;

                    message.textContent =
                        'Photo ready.';
                };

            photo.onerror =
                function() {

                    check.disabled =
                        true;

                    message.textContent =
                        'This image could not be opened. Try another image.';
                };

            photo.src =
                e.target.result;
        };

    reader.onerror =
        function() {

            check.disabled =
                true;

            message.textContent =
                'The photo could not be read. Please try again.';
        };

    reader.readAsDataURL(f);
}


// ==========================================
// FILE INPUT
// ==========================================

file.addEventListener(
    'change',
    function(e) {

        choose(
            e.target.files[0]
        );
    }
);


// ==========================================
// DRAG & DROP
// ==========================================

['dragenter', 'dragover']
.forEach(function(ev) {

    drop.addEventListener(
        ev,
        function(e) {

            e.preventDefault();

            drop.classList.add('over');
        }
    );
});


['dragleave', 'drop']
.forEach(function(ev) {

    drop.addEventListener(
        ev,
        function(e) {

            e.preventDefault();

            drop.classList.remove('over');
        }
    );
});


drop.addEventListener(
    'drop',
    function(e) {

        choose(
            e.dataTransfer.files[0]
        );
    }
);


// ==========================================
// CHOOSE ANOTHER
// ==========================================

again.addEventListener(
    'click',
    function() {

        file.value = '';

        preview.style.display =
            'none';

        actions.style.display =
            'none';

        result.style.display =
            'none';

        message.textContent =
            'Ready.';
    }
);


// ==========================================
// CHECK FRESHNESS
// ==========================================

check.addEventListener(
    'click',
    async function() {

        if (
            !photo.src ||
            !photo.complete ||
            !photo.naturalWidth
        ) {

            message.textContent =
                'Please wait for the photo to finish loading.';

            return;
        }


        if (!aiModel) {

            message.textContent =
                'AI model is still loading. Please wait.';

            console.error(
                "Check clicked before model loaded."
            );

            return;
        }


        check.disabled = true;

        again.disabled = true;

        message.textContent =
            'Analyzing with FreshCheck AI…';


        try {

            var prediction =
                await analyzeImage(photo);


            var className =
                prediction.className;


            var confidenceValue =
                prediction.confidence;


            var confidencePercent =
                Math.round(
                    confidenceValue * 100
                );


            // ------------------------------
            // IDENTIFY FRUIT
            // ------------------------------

            var fruitName =
                "Unknown";


            if (
                className.indexOf(
                    "apple"
                ) !== -1
            ) {

                fruitName =
                    "Apple";

            } else if (
                className.indexOf(
                    "banana"
                ) !== -1
            ) {

                fruitName =
                    "Banana";

            } else if (
                className.indexOf(
                    "orange"
                ) !== -1
            ) {

                fruitName =
                    "Orange";
            }


            // ------------------------------
            // FRESH OR ROTTEN
            // ------------------------------

            var isFresh =
                className.indexOf(
                    "fresh"
                ) === 0;


            if (isFresh) {

                state.textContent =
                    "Looks fresh";

                state.className =
                    "big use";

                rec.textContent =
                    "Use now";

                rec.className =
                    "big use";

                details.textContent =
                    "FreshCheck AI classified this as a fresh " +
                    fruitName.toLowerCase() +
                    ".";

            } else {

                state.textContent =
                    "Past its best";

                state.className =
                    "big discard";

                rec.textContent =
                    "Discard";

                rec.className =
                    "big discard";

                details.textContent =
                    "FreshCheck AI classified this as a rotten " +
                    fruitName.toLowerCase() +
                    ".";
            }


            // ------------------------------
            // RESULT INFORMATION
            // ------------------------------

            bar.style.width =
                confidencePercent + "%";


            confidence.textContent =
                "AI confidence: " +
                confidencePercent +
                "%";


            produce.textContent =
                "Detected: " +
                fruitName;


            result.style.display =
                'block';


            message.textContent =
                'AI analysis complete.';


        } catch (error) {

            console.error(
                "FreshCheck AI error:",
                error
            );

            message.textContent =
                "The AI could not analyze this photo.";

        } finally {f

            check.disabled =
                false;

            again.disabled =
                false;
        }
    }
);


// ==========================================
// START AI
// ==========================================

loadAIModel();

</script>
</body>
</html>
